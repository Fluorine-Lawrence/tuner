<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp">

    <!-- 乐器选择条（横向滚动） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/instrumentRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 顶部纠错提示胶囊 -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:background="@drawable/bg_hint"
        android:minHeight="40dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:text="请拨动琴弦…" />

    <!-- 音名大字 -->
    <TextView
        android:id="@+id/noteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textColor="@color/text_primary"
        android:textSize="80sp"
        android:textStyle="bold"
        android:text="—" />

    <TextView
        android:id="@+id/detailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="17sp"
        android:text="" />

    <!-- 指针仪表盘 -->
    <com.guitartuner.ui.TunerGaugeView
        android:id="@+id/gauge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/freqText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="@color/text_dim"
        android:textSize="15sp"
        android:text="" />

    <TextView
        android:id="@+id/centsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:text="" />

    <!-- 弦选择条（横向滚动） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/stringRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/modeButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:text="智能模式" />

        <Button
            android:id="@+id/tuningButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:text="选择调弦" />
    </LinearLayout>
</LinearLayout>
